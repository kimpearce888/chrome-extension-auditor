{
  "manifest_version": 3,
  "name": "Local Chrome Extension Auditor",
  "short_name": "Extension Auditor",
  "version": "1.0.0",
  "description": "Fully local security, privacy, performance and code-health auditor for your installed Chrome extensions. No cloud, no telemetry.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Local Extension Auditor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["management", "nativeMessaging", "storage", "alarms"],
  "optional_permissions": ["notifications"],
  "options_page": "dashboard.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" }
    }
  }
}
