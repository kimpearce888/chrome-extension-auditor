{
  "manifest_version": 2,
  "name": "Legacy MV2 Fixture",
  "version": "2.4.1",
  "permissions": [
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self' 'unsafe-eval' https://cdn.example.com; object-src 'self'"
}